---
import Container from "../ui/Container.astro";
import "swiper/css";
---

<section class="reviews">
    <Container>
        <div class="reviews__inner">
            <div class="reviews__left">
                <h3 class="reviews__title title">
                    Hear What Our <span>Clients Say</span>
                </h3>

                <div class="reviews__clients-group">
                    <div class="reviews__clients">
                        {Array.from({ length: 4 }).map((_, i) => (
                            <img
                                class="reviews__client"
                                data-client={i + 1}
                                src={`/client-${i + 1}.png`}
                                alt={`client-${i + 1}`}
                            />
                        ))}
                    </div>
                    <p class="reviews__clients-count">138+ Clients Worldwide</p>
                </div>
            </div>

            <div class="reviews__right swiper">
                <div class="gradient"></div>
                <div class="gradient right"></div>
                <div class="swiper-wrapper">
                    <div class="reviews__review swiper-slide">
                        <div class="reviews__review-text">
                            <p class="reviews__review-title">Exceptional Workmanship!</p>
                            <span class="reviews__review-description">
                            “Lorem Ipsum is simply dummy text of the printing and typesetting industry. Lorem Ipsum has been the industry's standard dummy text ever since the 1500s, when an unknown printer took a galley of type and scrambled it to make a type specimen book. It has survived not only five centuries, but also the leap into electronic typesetting, remaining essentially unchanged. It was popularised in the 1960s with the release”.
                        </span>
                        </div>
                        <div class="reviews__review-bottom">
                            <div class="reviews__user">
                                <img src="/client-1.png" class="reviews__user-avatar" alt="client" />
                                <div class="reviews__user-info">
                                    <p class="reviews__user-name">Sarah Johnson</p>
                                    <span class="reviews__user-role">House Renovation</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="reviews__review swiper-slide">
                        <div class="reviews__review-text">
                            <p class="reviews__review-title">Exceptional Workmanship!</p>
                            <span class="reviews__review-description">
                            “Lorem Ipsum is simply dummy text of the printing and typesetting industry. Lorem Ipsum has been the industry's standard dummy text ever since the 1500s, when an unknown printer took a galley of type and scrambled it to make a type specimen book. It has survived not only five centuries, but also the leap into electronic typesetting, remaining essentially unchanged. It was popularised in the 1960s with the release”.
                        </span>
                        </div>
                        <div class="reviews__review-bottom">
                            <div class="reviews__user">
                                <img src="/client-2.png" class="reviews__user-avatar" alt="client" />
                                <div class="reviews__user-info">
                                    <p class="reviews__user-name">Sarah Johnson</p>
                                    <span class="reviews__user-role">House Renovation</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="reviews__review swiper-slide">
                        <div class="reviews__review-text">
                            <p class="reviews__review-title">Exceptional Workmanship!</p>
                            <span class="reviews__review-description">
                            “Lorem Ipsum is simply dummy text of the printing and typesetting industry. Lorem Ipsum has been the industry's standard dummy text ever since the 1500s, when an unknown printer took a galley of type and scrambled it to make a type specimen book. It has survived not only five centuries, but also the leap into electronic typesetting, remaining essentially unchanged. It was popularised in the 1960s with the release”.
                        </span>
                        </div>
                        <div class="reviews__review-bottom">
                            <div class="reviews__user">
                                <img src="/client-3.png" class="reviews__user-avatar" alt="client" />
                                <div class="reviews__user-info">
                                    <p class="reviews__user-name">Sarah Johnson</p>
                                    <span class="reviews__user-role">House Renovation</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="reviews__review swiper-slide">
                        <div class="reviews__review-text">
                            <p class="reviews__review-title">Exceptional Workmanship!</p>
