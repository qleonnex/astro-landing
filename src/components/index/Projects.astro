---

<section class="projects">
    <div class="projects__band" data-js-band-top>
        {PROJECTS.top.map((project, i) => (
            <div class="projects__img-wrapper">
                <img class="projects__img" src={project} alt={`project image ${i}`}>
            </div>
        ))}
    </div>
    <div class="projects__band" data-js-band-bottom>
        {PROJECTS.bottom.reverse().map((project, i) => (
            <div class="projects__img-wrapper">
                <img class="projects__img" src={project} alt={`project image ${i}`}>
            </div>
        ))}
    </div>
</section>

<script>
    const bandTop = document.querySelector<HTMLElement>("[data-js-band-top]");
    const bandBottom = document.querySelector<HTMLElement>("[data-js-band-bottom]");

    function handleTwistBand(el: HTMLElement | null, speed: number) {
        if (!el) return;

        let x = 0;
        let currentSpeed = speed;
        let lastTime = performance.now();

        const animate = (time: number) => {
            const delta = time - lastTime;
            lastTime = time;
            x += currentSpeed * delta * 0.06;

            const lastChild = el.lastElementChild as HTMLElement;

            if (speed >= 1 && lastChild) {
                const rect = lastChild.getBoundingClientRect();

                if (rect.left > window.innerWidth) {
                    el.prepend(lastChild);
                    x -= rect.width + 15;
                }
            }

            const firstChild = el.firstElementChild as HTMLElement;

            if (speed < 1 && lastChild) {
                const rect = firstChild.getBoundingClientRect();

                if (rect.right < 0) {
                    el.appendChild(firstChild);
                    x += rect.width + 15;
                }
            }

            el.style.transform = `translateX(${x}px)`;
            requestAnimationFrame(animate);
        };

        el.addEventListener("mouseenter", () => {
            currentSpeed = 0;
        });

        el.addEventListener("mouseleave", () => {
            currentSpeed = speed;
        });

        requestAnimationFrame(animate);
    }


    handleTwistBand(bandTop, 1);
    handleTwistBand(bandBottom, -1);
</script>

<style>
    .projects {
        display: flex;
        flex-direction: column;
        gap: 20px;
        overflow: hidden;
    }

    .projects__band {
        display: flex;
        justify-content: right;
        align-items: center;
        gap: 15px;
    }

    .projects__band:last-child {
        justify-content: left;
    }

    .projects__img-wrapper {
        display: flex;
        justify-content: center;
        align-items: center;

        min-width: 413px;
        height: 292px;
        border-radius: 20px;
        overflow: hidden;
    }

    .projects__img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
</style>