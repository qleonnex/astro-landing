---
import Link from "./Link.astro";

export interface Card {
    imgSrc: string;
    title: string;
    href: string;
}

interface Props extends Card {}

const { imgSrc, title, href } = Astro.props;

---

<div
    class="service-card"
    style={`background-image: url("${imgSrc}")`}
>
    <div class="bg"></div>
    <div class="service-card__link">
        <Link href={href} hasIcon isOnlyIcon />
    </div>
    <div class="service-card__info">
        <p>{title}</p>
        <span>
            Lorem Ipsum is simply dummy text of the printing and typesetting industry. Lorem Ipsum has been the industry's standard dummy text ever since the 1500s, when  an unknown printer took a galley of type  and scrambled it to make a type specimen.
        </span>
    </div>
</div>

<style>
    .green {
        background-color: green;
    }

    .service-card {
        position: relative;

        background-repeat: no-repeat;
        background-size: cover;
        background-position: center;

        border-radius: 15px;
        overflow: hidden;
    }

    .service-card:nth-child(2) {
        grid-column: 2/4;
    }

    .service-card > .bg {
        position: absolute;
        top: 0;
        left: 0;

        background: linear-gradient(180deg, rgba(0, 0, 0, 0%) 0%, rgba(0, 0, 0, 96%) 52%, rgba(0, 0, 0, 100%) 100%);
        width: 100%;
        height: 100%;
        opacity: .6;

        transition: background .3s ease;
    }

    .service-card:hover > .bg {
        background: linear-gradient(180deg, rgba(19, 100, 246, 0%) 0%, rgba(19, 100, 246, 96%) 52%, rgba(19, 100, 246, 100%) 100%);
        opacity: 1;
    }

    .service-card__link {
        position: absolute;
        top: 25px;
        right: 25px;
    }

    .service-card__info {
        position: absolute;
        bottom: 0;

        display: flex;
        flex-direction: column;
        gap: 21px;

        margin-top: auto;
        padding: 0 25px 42px 40px;
        color: #FFF;

        transform: translateY(calc(100% - 70px));
        transition: transform .4s ease;
    }

    .service-card:hover .service-card__info {
        transform: translateY(0);
    }

    .service-card__info p {
        font-size: 36px;
        font-weight: 600;
    }

    .service-card__info span {
        opacity: 0;
        transform: translateY(20%);
        transition: .3s ease;
    }

    .service-card:hover .service-card__info span {
        opacity: 1;
        transform: translateY(0);
    }
</style>