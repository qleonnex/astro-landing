---
interface Props {
    size?: "lg" | "sm"
}

const { size = "lg" } = Astro.props;

const classOfComponent = {
    lg: "container-lg",
    sm: "container-sm"
}[size]
---

<div class={classOfComponent}>
    <slot />
</div>

<style>
    .container-lg {
        max-width: 1400px;
        margin-inline: auto;
        padding-inline: 16px;
    }

    .container-sm {
        max-width: 996px;
        margin-inline: auto;
        padding-inline: 16px;
    }
</style>